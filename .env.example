# ===== LLM provider: mock | openai | ollama =====
LLM_PROVIDER=mock                 # mock = demo without a model (NOT for real scoring)

# --- cloud (any OpenAI-compatible API) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # OpenRouter: https://openrouter.ai/api/v1 ; DeepSeek: https://api.deepseek.com ; Groq: https://api.groq.com/openai/v1
# LLM_MODEL=gpt-4o-mini

# --- local (Ollama) ---
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:14b
# OLLAMA_NUM_CTX=16384

# ===== accuracy knobs =====
EVAL_MODE=per_criterion           # per_criterion (accurate, 1 call per criterion) | batch (cheap, 1 call per dialog)
EVAL_SAMPLES=1                    # 3 = self-consistency voting (3x cost, more stable)
EVAL_SAMPLES_KZ=3                 # per-language override: Kazakh is harder for small models
# LLM_MODEL_KZ=gpt-4o             # per-language model override (e.g. a stronger model only for KZ)

# ===== roles (optional) — if set, the role needs X-Token in the UI =====
# REVIEWER_TOKEN=
# ADMIN_TOKEN=
